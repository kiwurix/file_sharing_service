[Unit]
Description=File Sharing Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=file-sharing
Group=file-sharing
WorkingDirectory=/opt/file-sharing
ExecStart=/opt/file-sharing/.venv/bin/python -m file_sharing_server --config /etc/file-sharing/server.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
